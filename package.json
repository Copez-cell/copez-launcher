{
  "name": "copez-launcher",
  "version": "1.2.5",
  "description": "COPEZ Game Launcher",
  "main": "./out/main/index.js",
  "author": "COPEZ",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win",
    "package:portable": "electron-vite build && electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.copez.launcher",
    "productName": "COPEZ Launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "Copez-cell",
        "repo": "copez-launcher",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "src/main/data/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "src/main/data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico",
        "filter": [
          "icon.ico"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerSidebar": "resources/sidebar.bmp",
      "installerHeader": "resources/header.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "COPEZ Launcher",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@supabase/supabase-js": "^2.111.0",
    "archiver": "^8.0.0",
    "bufferutil": "^4.1.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "recharts": "^3.10.1",
    "screenshot-desktop": "^1.15.4",
    "sharp": "^0.35.5",
    "systeminformation": "^5.33.1",
    "utf-8-validate": "^5.0.10"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.0"
  }
}
